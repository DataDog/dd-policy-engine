namespace dd.wls;

/// Canonical set of runtime languages recognized by the policy engine.
/// The string representation uses lowercase (e.g. "jvm", "python").
/// IMPORTANT! When adding a new value make sure you add it BEFORE the _COUNT entry.
enum RuntimeLanguage : byte {
    RUNTIME_LANGUAGE_UNKNOWN = 0,
    JVM,
    PYTHON,
    RUBY,
    DOTNET,
    NODEJS,
    PHP,
    RUNTIME_LANGUAGE_COUNT
}

/// Canonical set of operating systems recognized by the policy engine.
/// The string representation uses lowercase (e.g. "linux", "windows").
/// IMPORTANT! When adding a new value make sure you add it BEFORE the _COUNT entry.
enum OperatingSystem : byte {
    OS_UNKNOWN = 0,
    LINUX,
    WINDOWS,
    MACOS,
    OS_COUNT
}

/// Canonical set of machine architectures recognized by the policy engine.
/// The string representation uses the kernel-reported format (e.g. "aarch64", "x86_64", "arm").
/// IMPORTANT! When adding a new value make sure you add it BEFORE the _COUNT entry.
enum MachineArchitecture : byte {
    ARCH_UNKNOWN = 0,
    AARCH64,    // arm64, aarch64
    X86_64,     // x64, x86_64, amd64
    ARM,        // 32-bit ARM
    MACHINE_ARCHITECTURE_COUNT
}